{
  "name": "pvm-host-runtime-workspace",
  "private": true,
  "version": "0.1.9",
  "description": "Host-neutral PolkaVM application runtime workspace",
  "license": "MPL-2.0",
  "type": "module",
  "workspaces": [
    "js/packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @parity/pvm-browser-runtime",
    "test": "npm run test --workspace @parity/pvm-browser-runtime && node scripts/verify-browser-assets.mjs",
    "verify:assets": "node scripts/verify-browser-assets.mjs",
    "manifest": "node scripts/create-release-manifest.mjs --output artifacts/runtime-release.json",
    "pack:browser": "npm pack --workspace @parity/pvm-browser-runtime"
  },
  "engines": {
    "node": ">=22"
  }
}
